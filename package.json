{
  "name": "ugs-web-hub",
  "version": "1.0.0",
  "description": "Personal project to build a fast web hub for the Ultimate Game Stash.",
  "main": "games-data.js",
  "scripts": {
    "build:card-media": "node generate-game-card-media.js",
    "build:card-media:local": "node scripts/build-local-card-media.cjs",
    "build:card-media:local:dry": "set MEDIA_LOCAL_DRY_RUN=1&& node scripts/build-local-card-media.cjs",
    "enrich:card-media:bing": "node scripts/enrich-card-media-from-bing.cjs",
    "enrich:card-media:bing:dry": "set BING_MEDIA_DRY_RUN=1&& node scripts/enrich-card-media-from-bing.cjs",
    "enrich:card-media": "node scripts/enrich-card-media-from-search.cjs",
    "enrich:card-media:dry": "set MEDIA_DRY_RUN=1&& node scripts/enrich-card-media-from-search.cjs",
    "build:game-pages": "node scripts/build-game-detail-pages.cjs",
    "build:sitemap": "node generate-sitemap.js",
    "build:content": "node scripts/build-game-detail-pages.cjs && node generate-sitemap.js",
    "import:ugs-doc": "node scripts/import-ugs-doc.js && node generate-game-titles.js && node generate-game-card-media.js",
    "check:links": "node scripts/check-links.cjs",
    "check:sitemap": "node scripts/check-sitemap.cjs",
    "check:rulesets": "node scripts/check-rulesets.cjs",
    "check": "npm run check:links && npm run check:sitemap && npm run check:rulesets && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanstonator-lang/UGS-Web-Hub.git"
  },
  "keywords": [
    "ultimate-game-stash",
    "ugs",
    "game-hub",
    "games",
    "browser-games",
    "game-library",
    "github-pages",
    "playwright"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/seanstonator-lang/UGS-Web-Hub/issues"
  },
  "homepage": "https://ugswebhub.com",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.2"
  }
}
